# Variáveis de ambiente do agente
# Copie este arquivo para .env e preencha os valores

# ----------------------------
# LLM (Google AI Studio)
# ----------------------------
GOOGLE_API_KEY=AIza...          # Obrigatório — obtenha em https://aistudio.google.com/app/apikey
MODEL=gemini-1.5-flash          # Opcional (padrão: gemini-1.5-flash)
TEMPERATURE=0.2                 # Opcional (padrão: 0.2)

# ----------------------------
# Agente
# ----------------------------
MAX_ITERATIONS=10               # Opcional (padrão: 10)
